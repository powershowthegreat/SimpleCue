PORT=3000
# Required on Vercel. Leave both empty to use a local JSON store in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required for cloud media uploads on Vercel. Connect a public Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Optional, isolates metadata and sessions between installations.
REDIS_PREFIX=simplecue:v1
